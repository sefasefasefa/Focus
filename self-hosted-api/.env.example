PORT=8787
BIND_HOST=127.0.0.1
DATA_PATH=./data/licenses.sqlite
TRUST_PROXY=true

# Set the exact seller account ID from Shopier's webhook header.
SHOPIER_ACCOUNT_ID=
# New webhook signing token generated for your Shopier app. Do not use an API access token here.
SHOPIER_WEBHOOK_TOKEN=
# Map eligible monthly Shopier product IDs to 30 days. Other durations are not accepted.
SHOPIER_LICENSE_PRODUCTS={}
SHOPIER_CHECKOUT_URL=
# Optional per-product public name, price label, and HTTPS checkout URL.
SHOPIER_PLAN_DETAILS={}
# Maximum registered devices during the free trial. Paid monthly plans have no device-count cap.
LICENSE_MAX_DEVICES_DEFAULT=2

# Public HTTPS origin of this API, used to build password-reset links.
PUBLIC_API_BASE_URL=
# SMTP account used for account verification and password-reset emails.
# Use an app password, not the mailbox's normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# setup.mjs creates random values for these two secrets in your local .env.
LICENSE_SIGNING_SECRET=
LICENSE_DATA_SECRET=
# setup.mjs creates a separate encryption key for customer Instagram sessions.
INSTAGRAM_SESSION_ENCRYPTION_KEY=

# Keep provider keys on this server only. Never place them in the extension.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
